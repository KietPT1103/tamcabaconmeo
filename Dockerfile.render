FROM php:8.3-apache
RUN apt-get update && apt-get install -y --no-install-recommends unzip libzip-dev libicu-dev libpq-dev \
    && docker-php-ext-install pdo_mysql pdo_pgsql zip intl opcache \
    && a2enmod rewrite && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN sed -ri 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/*.conf \
    && printf '<Directory /var/www/html/public>\nAllowOverride All\nRequire all granted\n</Directory>\n' > /etc/apache2/conf-available/laravel.conf \
    && a2enconf laravel
WORKDIR /var/www/html
COPY app/ .
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache
COPY docker/render-entrypoint.sh /usr/local/bin/start-render
RUN sed -i 's/\r$//' /usr/local/bin/start-render && chmod +x /usr/local/bin/start-render
EXPOSE 10000
ENTRYPOINT ["start-render"]
